# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used to enroll students on sign-in.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Discord server students must belong to. Leave blank to let anyone who signs
# in with Discord enroll themselves.
DISCORD_GUILD_ID=

# Slug of the course row students land on.
DEFAULT_COURSE_SLUG=day-trading
