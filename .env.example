# Copy to .env.local and fill in. See SETUP.md for where each value comes from.
# Next.js reads .env.local at startup — restart `pnpm dev` after editing.

# Supabase -> Project Settings -> API
# NOTE: this one is also read at BUILD time, to allow the storage host for
# custom thumbnails. A build without it cannot display them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses every row-level security rule — never expose to the
# browser, never prefix with NEXT_PUBLIC_. Used to enrol students on sign-in
# and to backfill lecture runtimes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Discord server students must belong to.
# WARNING: while this is blank, anyone with a Discord account who finds the URL
# can enrol themselves. Set it before sharing the site.
# Discord -> Settings -> Advanced -> Developer Mode, then right-click the
# server -> Copy Server ID.
DISCORD_GUILD_ID=

# Slug of the course row students land on. Must match supabase/seed.sql.
DEFAULT_COURSE_SLUG=day-trading
